FROM docker.io/library/ubuntu@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's/Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/ubuntu.sources
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev build-essential patchelf ccache \
    rsync rsgain ca-certificates curl desktop-file-utils file \
    libegl1 libgl1 libopengl0 libdbus-1-3 libxcb-cursor0 libxkbcommon0 libxkbcommon-x11-0 libwayland-client0 \
    dpkg-dev xz-utils zstd && rm -rf /var/cache/apt/archives/*.deb
RUN python3 -m venv /opt/build-python
RUN /opt/build-python/bin/pip install --no-cache-dir \
    PySide6==6.11.2 Nuitka==4.2.1 ordered-set==4.1.0 zstandard==0.25.0 patchelf==0.19.1.0
RUN apt-get install -y --no-install-recommends libwayland-cursor0 libwayland-egl1 \
    libxcb-icccm4 libxcb-keysyms1 libxcb-shape0
RUN apt-get install -y --no-install-recommends cmake pkg-config libavcodec-dev \
    libavformat-dev libavutil-dev libswresample-dev libtag1-dev libebur128-dev libinih-dev libfmt-dev
RUN curl -fL https://codeload.github.com/complexlogic/rsgain/tar.gz/refs/tags/v3.6 -o /opt/rsgain-3.6.tar.gz && \
    echo '26f7acd1ba0851929dc756c93b3b1a6d66d7f2f36b31f744c8181f14d7b5c8a7  /opt/rsgain-3.6.tar.gz' | sha256sum -c - && \
    tar xf /opt/rsgain-3.6.tar.gz -C /opt && \
    cmake -S /opt/rsgain-3.6 -B /opt/rsgain-build -DCMAKE_BUILD_TYPE=Release -DCMAKE_DISABLE_FIND_PACKAGE_Git=ON && \
    cmake --build /opt/rsgain-build -j4 && cmake --install /opt/rsgain-build
# Refresh inherited base packages too: superseded security binaries can remain
# installed even when their exact source version has left the repository index.
# The source collector still requires an exact binary/source version match.
RUN apt-get update && apt-get upgrade -y
RUN apt-get install -y --no-install-recommends p7zip-full ninja-build gettext \
    libx11-dev libxkbcommon-dev libwayland-dev wayland-protocols libsm-dev libice-dev \
    libzstd-dev liblzma-dev libbz2-dev libgl-dev libegl-dev libopengl-dev libssl-dev
RUN /opt/build-python/bin/pip install --no-cache-dir cmake==3.31.6 lxml==6.1.3
# Runtime closure for the GTK3 platform theme from the same PySide wheel as Qt.
# The GTK and dconf packages are private build inputs, never host installations.
RUN apt-get install -y --no-install-recommends libgtk-3-0t64 dconf-gsettings-backend libglib2.0-bin
ENV PATH="/opt/build-python/bin:${PATH}"
WORKDIR /work
